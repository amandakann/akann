nything.","anchor":"cldf2-13308"},{"id":"cldf2-13438","tx":"Yena khona lo gane?","sg":["Yena","khon-a","lo","gane?"],"gl":["she","have-V","ART","child"],"tl":"Does she have children?","anchor":"cldf2-13438"},{"id":"cldf2-13775","tx":"Zonke lo tombazana hamba lapa stolo; wena futhi hamba.","sg":["Zonke","lo","tombazana","hamb-a","lapa","stolo;","wena","futhi","hamb-a."],"gl":["all","DEF.ART","girl","go-V","LOC.PREP","shop","you","too","go-IMP"],"tl":"All the girls are going to the shop; you too go!","anchor":"cldf2-13775"},{"id":"cldf2-13861","tx":"We John!","sg":["We","John!"],"gl":["oh","John"],"tl":"Oh John!","anchor":"cldf2-13861"},{"id":"cldf2-14096","tx":"manzi ga mehlo","sg":["manzi","ga","mehlo"],"gl":["water","POSS","eyes"],"tl":"eye-water OR: tears","anchor":"cldf2-14096"},{"id":"cldf2-14097","tx":"nymbezi","sg":["nymbezi"],"gl":["tears"],"tl":"tears","anchor":"cldf2-14097"},{"id":"cldf2-14210","tx":"sandla","sg":["sandla"],"gl":["hand/arm"],"tl":"hand, arm","anchor":"cldf2-14210"},{"id":"cldf2-14346","tx":"munwe vs. zwane","sg":["munwe","vs.","zwane"],"gl":["finger","vs.","toe"],"tl":"finger vs.","anchor":"cldf2-14346"},{"id":"cldf2-14487","tx":"phape","sg":["phape"],"gl":["feather"],"tl":"feather","anchor":"cldf2-14487"},{"id":"cldf2-14488","tx":"nwele","sg":["nwele"],"gl":["hair.on.head"],"tl":"hair","anchor":"cldf2-14488"},{"id":"cldf2-14771","tx":"luhlaza vs. bluwan","sg":["luhlaza","vs.","bluwan"],"gl":["green/blue","vs.","blue"],"tl":"green vs.","anchor":"cldf2-14771"},{"id":"cldf2-14896","tx":"inja vs. injakazi","sg":["inja","vs.","injakazi"],"gl":["dog","vs.","bitch"],"tl":"dog vs.","anchor":"cldf2-14896"},{"id":"cldf2-15134","tx":"skwam","sg":["skwam"],"gl":["pocket"],"tl":"pocket","anchor":"cldf2-15134"},{"id":"cldf2-15135","tx":"streyit","sg":["streyit"],"gl":["straight"],"tl":"straight OR: completely","anchor":"cldf2-15135"},{"id":"cldf2-15136","tx":"majistret","sg":["majistret"],"gl":["magistrate"],"tl":"magistrate","anchor":"cldf2-15136"},{"id":"cldf2-15740","tx":"Lo John na lo Jane yena hambile lapha Thegwin.","sg":["Lo","John","na","lo","Jane","yena","hamb-ile","lapha","Thegwin."],"gl":["DEF.ART","John","COM","DEF.ART","Jane","they","go-PST","DAT","Durban"],"tl":"John and Jane went to Durban.","anchor":"cldf2-15740"}],"flagged":[{"id":"cldf2-853","tx":"lo side","sg":["lo","side"],"gl":["this","side"],"tl":"this side OR: that side (The meanings 'this' versus 'that' for lo may be expressed tonally by some speakers .","flags":["TL: parentheses"],"ftypes":["TL: parentheses"],"clean_log":"removed trailing TL content: ‘Less proficient speakers may rely on accompanying hand gestures to clarify meaning. Side in this example is a loanword from English.)’ | removed unbalanced single quote(s) from TL | removed ‘(...)’ annotations from TL","orig":{"tx":"lo side","sg":["lo","side"],"gl":["this","side"],"tl":"this side OR: that side' (The meanings 'this' versus 'that' for lo may be expressed tonally by some speakers (low tone for 'this' and high tone for 'that'). Less proficient speakers may rely on accompanying hand gestures to clarify meaning. Side in this example is a loanword from English.)"},"anchor":"cldf2-853"},{"id":"cldf2-1110","tx":"Lo kuba yena lo into lo tina lima ka yena [...].","sg":["Lo","kuba","yena","lo","into","lo","tina","lim-a","ka","yena","[...]."],"gl":["ART","hoe","it","ART","thing","REL","we","plough-V","INS","it","[...]"],"tl":"A hoe is a thing that we plough with […].","flags":["TX: bracket characters ['[', ']']","SG: bracket characters ['[', ']']","TL: bracket characters ['[', ']']"],"ftypes":["SG: bracket characters","TL: bracket characters","TX: bracket characters"],"clean_log":"resolved TL slash: kept first 'Zulu', dropped 'Xhosa' | removed trailing TL content: ‘' (The example has been shortened. The relative marker lo has high tone (and length) to distinguish it from the article lo. Both forms derive from the Zulu demonstrative lo.)’","orig":{"tx":"Lo kuba yena lo into lo tina lima ka yena [...].","sg":["Lo","kuba","yena","lo","into","lo","tina","lim-a","ka","yena","[...]."],"gl":["ART","hoe","it","ART","thing","REL","we","plough-V","INS","it","[...]"],"tl":"A hoe is a thing that we plough with […].' (The example has been shortened. The relative marker lo has high tone (and length) to distinguish it from the article lo. Both forms derive from the Zulu/Xhosa demonstrative lo.)"},"anchor":"cldf2-1110"},{"id":"cldf2-1481","tx":"Mina funa (muye) (lo) geja.","sg":["Mina","funa","(muye)","(lo)","geja."],"gl":["I","want","(one)","(ART)","hoe"],"tl":"I want a hoe.","flags":["TX: parentheses","SG: parentheses"],"ftypes":["SG: parentheses","TX: parentheses"],"clean_log":"removed trailing TL content: ‘' (The article is optional. Some authors consider the pidgin not to have an indefinite article. Note that the definite article lo can sometimes have indefinite meaning.)’","orig":{"tx":"Mina funa (muye) (lo) geja.","sg":["Mina","funa","(muye)","(lo)","geja."],"gl":["I","want","(one)","(ART)","hoe"],"tl":"I want a hoe.' (The article is optional. Some authors consider the pidgin not to have an indefinite article. Note that the definite article lo can sometimes have indefinite meaning.)"},"anchor":"cldf2-1481"},{"id":"cldf2-2123","tx":"Thina zo hamba gusasa.","sg":["Thina","zo","hamb-a","gusasa."],"gl":["we","will","go-V","tomorrow"],"tl":"We (incl.","flags":["TL: parentheses"],"ftypes":["TL: parentheses"],"clean_log":"removed trailing TL content: ‘or excl.) will go tomorrow.' (There is no difference between inclusive and exclusive meaning.)’","orig":{"tx":"Thina zo hamba gusasa.","sg":["Thina","zo","hamb-a","gusasa."],"gl":["we","will","go-V","tomorrow"],"tl":"We (incl. or excl.) will go tomorrow.' (There is no difference between inclusive and exclusive meaning.)"},"anchor":"cldf2-2123"},{"id":"cldf2-2764","tx":"(y)ini skati","sg":["(y)ini","skati"],"gl":["what","time"],"tl":"when (An alternative used by some speakers is (y)ipi skati, literally 'where time' = 'when'.)","flags":["TX: parentheses","SG: parentheses","TL: parentheses"],"ftypes":["SG: parentheses","TL: parentheses","TX: parentheses"],"clean_log":"removed unbalanced single quote(s) from TL","orig":{"tx":"(y)ini skati","sg":["(y)ini","skati"],"gl":["what","time"],"tl":"when' (An alternative used by some speakers is (y)ipi skati, literally 'where time' = 'when'.)"},"anchor":"cldf2-2764"},{"id":"cldf2-5430","tx":"Ga mina","sg":["Ga","mina"],"gl":["POSS","I"],"tl":"mine OR: of me (This is an appropriate answer to a question like: Lo geja ga obani?","flags":["TL: parentheses"],"ftypes":["TL: parentheses"],"clean_log":"resolved TL slash: kept first 'whom?', dropped 'Whose' | removed trailing TL content: ‘(The hoe of whom? hoe?))’ | removed unbalanced single quote(s) from TL","orig":{"tx":"Ga mina","sg":["Ga","mina"],"gl":["POSS","I"],"tl":"mine OR: of me' (This is an appropriate answer to a question like: Lo geja ga obani? (The hoe of whom? / Whose hoe?))"},"anchor":"cldf2-5430"},{"id":"cldf2-6055","tx":"[...] yena zo gate hambile.","sg":["[...]","yena","zo","gate","hamb-ile."],"gl":["[...]","he","FUT","ANT","go-PST"],"tl":"[…] he will have gone.","flags":["TX: bracket characters ['[', ']']","SG: bracket characters ['[', ']']","TL: bracket characters ['[', ']']"],"ftypes":["SG: bracket characters","TL: bracket characters","TX: bracket characters"],"clean_log":"removed trailing TL content: ‘OR: […] he will be gone.' (This clause requires a main clause like \"By the time you go there\" to make the example idiomatic.)’","orig":{"tx":"[...] yena zo gate hambile.","sg":["[...]","yena","zo","gate","hamb-ile."],"gl":["[...]","he","FUT","ANT","go-PST"],"tl":"[…] he will have gone. OR: […] he will be gone.' (This clause requires a main clause like \"By the time you go there\" to make the example idiomatic.)"},"anchor":"cldf2-6055"},{"id":"cldf2-10794","tx":"Yena zo hamba (lapha) Thekwin.","sg":["Yena","zo","hamb-a","(lapha)","Thekwin."],"gl":["he","will","go-V","(LOC.PREP)","Durban"],"tl":"He will go to Durban.","flags":["TX: parentheses","SG: parentheses"],"ftypes":["SG: parentheses","TX: parentheses"],"clean_log":"removed trailing TL content: ‘' (The preposition may be deleted; in fact, the preposition lapha is a general locative 'near, around, at'.)’","orig":{"tx":"Yena zo hamba (lapha) Thekwin.","sg":["Yena","zo","hamb-a","(lapha)","Thekwin."],"gl":["he","will","go-V","(LOC.PREP)","Durban"],"tl":"He will go to Durban.' (The preposition may be deleted; in fact, the preposition lapha is a general locative 'near, around, at'.)"},"anchor":"cldf2-10794"},{"id":"cldf2-11873","tx":"Lo skafu yena phekiwe (ga lo Jane).","sg":["Lo","skafu","yena","phek-iwe","(ga","lo","Jane)."],"gl":["DEF.ART","food","it","cook-PASS","(AG","DEF.ART","Jane)"],"tl":"The food was cooked (by Jane).","flags":["TX: parentheses","SG: parentheses","TL: parentheses"],"ftypes":["SG: parentheses","TL: parentheses","TX: parentheses"],"clean_log":"removed trailing TL content: ‘' (The passive is rare, and may be lexical: occurring with a small set of verbs with resulting adjectival meaning: 'cooked', 'ripe', 'closed', 'open', and seldom occurring with an overt, passivized by-agent phrase. However more proficient speakers do produce forms like 'was born' and also have two passive suffixes: -wa for present 'is closed' and -iwe for past 'was closed'). So though restricted, I think the pidgin just about has a passive that uses a suffix (or two for some speakers).)’","orig":{"tx":"Lo skafu yena phekiwe (ga lo Jane).","sg":["Lo","skafu","yena","phek-iwe","(ga","lo","Jane)."],"gl":["DEF.ART","food","it","cook-PASS","(AG","DEF.ART","Jane)"],"tl":"The food was cooked (by Jane).' (The passive is rare, and may be lexical: occurring with a small set of verbs with resulting adjectival meaning: 'cooked', 'ripe', 'closed', 'open', and seldom occurring with an overt, passivized by-agent phrase. However more proficient speakers do produce forms like 'was born' and also have two passive suffixes: -wa for present 'is closed' and -iwe for past 'was closed'). So though restricted, I think the pidgin just about has a passive that uses a suffix (or two for some speakers).)"},"anchor":"cldf2-11873"},{"id":"cldf2-12212","tx":"Lo indhlu mina tengile [...].","sg":["Lo","indhlu","mina","tengile","[...]."],"gl":["DEF.ART","house","I","buy.PST","[...]"],"tl":"The house I bought […].","flags":["TX: bracket characters ['[', ']']","SG: bracket characters ['[', ']']","TL: bracket characters ['[', ']']"],"ftypes":["SG: bracket characters","TL: bracket characters","TX: bracket characters"],"clean_log":"removed trailing TL content: ‘OR: The house which I bought […].' (I don't think this is really very common; it seems calqued on English usage.)’","orig":{"tx":"Lo indhlu mina tengile [...].","sg":["Lo","indhlu","mina","tengile","[...]."],"gl":["DEF.ART","house","I","buy.PST","[...]"],"tl":"The house I bought […]. OR: The house which I bought […].' (I don't think this is really very common; it seems calqued on English usage.)"},"anchor":"cldf2-12212"},{"id":"cldf2-12326","tx":"Lo kuba yena lo into tina lima ka yena [...]","sg":["Lo","kuba","yena","lo","into","tina","lim-a","ka","yena","[...]"],"gl":["ART","hoe","it","ART","thing","we","plough-V","INS","it","[...]"],"tl":"A hoe is a thing we plough with […].","flags":["TX: bracket characters ['[', ']']","SG: bracket characters ['[', ']']","TL: bracket characters ['[', ']']"],"ftypes":["SG: bracket characters","TL: bracket characters","TX: bracket characters"],"clean_log":"removed trailing TL content: ‘OR: A hoe is something that we plough with […].' (The absence of a relative particle is possible, but less idiomatic than having it in.)’","orig":{"tx":"Lo kuba yena lo into tina lima ka yena [...]","sg":["Lo","kuba","yena","lo","into","tina","lim-a","ka","yena","[...]"],"gl":["ART","hoe","it","ART","thing","we","plough-V","INS","it","[...]"],"tl":"A hoe is a thing we plough with […]. OR: A hoe is something that we plough with […].' (The absence of a relative particle is possible, but less idiomatic than having it in.)"},"anchor":"cldf2-12326"},{"id":"cldf2-13963","tx":"pikanin(i)","sg":["pikanin(i)"],"gl":["child"],"tl":"child OR: small","flags":["TX: parentheses","SG: parentheses"],"ftypes":["SG: parentheses","TX: parentheses"],"clean_log":"","orig":{"tx":"pikanin(i)","sg":["pikanin(i)"],"gl":["child"],"tl":"child OR: small"},"anchor":"cldf2-13963"},{"id":"cldf2-14627","tx":"izwa","sg":["izwa"],"gl":["to.hear"],"tl":"to hear, to perceive a smell ('To perceive a smell' is paraphrased by izwa 'to hear'.","flags":["TL: parentheses"],"ftypes":["TL: parentheses"],"clean_log":"removed trailing TL content: ‘'To smell' (intransitive) uses the Zulu verb nuka.)’ | removed unbalanced single quote(s) from TL","orig":{"tx":"izwa","sg":["izwa"],"gl":["to.hear"],"tl":"to hear, to perceive a smell' ('To perceive a smell' is paraphrased by izwa 'to hear'. 'To smell' (intransitive) uses the Zulu verb nuka.)"},"anchor":"cldf2-14627"}]}