21","tx":"kámuks","sg":["kámuks"],"gl":["dog"],"tl":"dog, dogs","anchor":"cldf2-3621"},{"id":"cldf2-3802","tx":"wáwa wáwa wáwa","sg":["wáwa","wáwa","wáwa"],"gl":["talk","talk","talk"],"tl":"talk and talk and talk","anchor":"cldf2-3802"},{"id":"cldf2-3803","tx":"łas mungk k’áu’kau dunusdunús","sg":["łas","mungk","k’áu’kau","dunusdunús"],"gl":["3PL","make","tie.RED","small.RED"],"tl":"they tied it up very tightly","anchor":"cldf2-3803"},{"id":"cldf2-4036","tx":"ukman","sg":["uk-man"],"gl":["the-man"],"tl":"the man' (The definite article derives fom ukuk 'this, that'.)","anchor":"cldf2-4036"},{"id":"cldf2-4037","tx":"uk yačêč","sg":["uk","ya-čêč"],"gl":["that","3SG-grandchild"],"tl":"the grandchild","anchor":"cldf2-4037"},{"id":"cldf2-4167","tx":"latáb","sg":["latáb"],"gl":["table"],"tl":"table, a table, the table, tables, the tables","anchor":"cldf2-4167"},{"id":"cldf2-4376","tx":"úkuk latáb","sg":["úkuk","latáb"],"gl":["this","table"],"tl":"this table, that table' (Úkuk latáb does not mean 'the table' in this lect of Chinuk Wawa.)","anchor":"cldf2-4376"},{"id":"cldf2-4377","tx":"haws","sg":["haws"],"gl":["house"],"tl":"house, the house, a house","anchor":"cldf2-4377"},{"id":"cldf2-4553","tx":"úkuk man","sg":["úkuk","man"],"gl":["this","man"],"tl":"this man","anchor":"cldf2-4553"},{"id":"cldf2-4554","tx":"úkuk wam","sg":["úkuk","wam"],"gl":["this","warm"],"tl":"This is warm.","anchor":"cldf2-4554"},{"id":"cldf2-4555","tx":"hayás úlman úkuk kánim","sg":["hayás","úlman","úkuk","kánim"],"gl":["much","old","this","canoe"],"tl":"This canoe is very old.","anchor":"cldf2-4555"},{"id":"cldf2-4556","tx":"ukílihi","sg":["uk-ílihi"],"gl":["the-earth"],"tl":"the earth","anchor":"cldf2-4556"},{"id":"cldf2-4687","tx":"úkuk man","sg":["úkuk","man"],"gl":["this","man"],"tl":"this man OR: that man","anchor":"cldf2-4687"},{"id":"cldf2-4688","tx":"yakwá","sg":["yakwá"],"gl":["here"],"tl":"here","anchor":"cldf2-4688"},{"id":"cldf2-4689","tx":"yawá","sg":["yawá"],"gl":["there"],"tl":"there","anchor":"cldf2-4689"},{"id":"cldf2-4747","tx":"kánawi man tk’up makwst stik","sg":["kánawi","man","tk’up","makwst","stik"],"gl":["all","man","cut","two","tree"],"tl":"The men cut two trees each.","anchor":"cldf2-4747"},{"id":"cldf2-4748","tx":"mákwsti","sg":["mákwsti"],"gl":["twice"],"tl":"twice","anchor":"cldf2-4748"},{"id":"cldf2-4991","tx":"ixt man","sg":["ixt","man"],"gl":["one","man"],"tl":"one man","anchor":"cldf2-4991"},{"id":"cldf2-5169","tx":"máyka haws","sg":["máyka","haws"],"gl":["2SG","house"],"tl":"your house OR: your houses","anchor":"cldf2-5169"},{"id":"cldf2-5170","tx":"tł’únas qáta máyka túmtum","sg":["tł’únas","qáta","máyka","túmtum"],"gl":["perhaps","what","1SG","heart"],"tl":"I don’t know why I feel this way.","anchor":"cldf2-5170"},{"id":"cldf2-5288","tx":"náyka haws","sg":["náyka","haws"],"gl":["1SG","house"],"tl":"my house","anchor":"cldf2-5288"},{"id":"cldf2-5289","tx":"man yáka haws","sg":["man","yáka","haws"],"gl":["man","3SG","house"],"tl":"the man's house","anchor":"cldf2-5289"},{"id":"cldf2-5449","tx":"kápa tláksta úkuk buk? náyka buk","sg":["kápa","tláksta","úkuk","buk?","náyka","buk"],"gl":["PREP","who","this","book","1SG","book"],"tl":"Whose book is this? It’s mine.","anchor":"cldf2-5449"},{"id":"cldf2-5553","tx":"cxi put","sg":["cxi","put"],"gl":["new","boat"],"tl":"new boat","anchor":"cldf2-5553"},{"id":"cldf2-5712","tx":"náyka haws hayú wam","sg":["náyka","haws","hayú","wam"],"gl":["1SG","house","much","warm"],"tl":"My house is very warm. OR: My house is warmer.","anchor":"cldf2-5712"},{"id":"cldf2-5803","tx":"pilpil ptl'ix kapa tʃak","sg":["pilpil","ptl'ix","kapa","tʃak"],"gl":["blood","thick","from","water"],"tl":"Blood is thicker than water.","anchor":"cldf2-5803"},{"id":"cldf2-5979","tx":"ánqati náyka mákmak","sg":["ánqati","náyka","mákmak"],"gl":["previously","1SG","eat"],"tl":"I ate. OR: I was eating.","anchor":"cldf2-5979"},{"id":"cldf2-5980","tx":"álta náyka mákmak","sg":["álta","náyka","mákmak"],"gl":["now","1SG","eat"],"tl":"I’m eating.","anchor":"cldf2-5980"},{"id":"cldf2-5981","tx":"álta pus łáska mákmak","sg":["álta","pus","łáska","mákmak"],"gl":["now","when","3PL","eat"],"tl":"and then they ate","anchor":"cldf2-5981"},{"id":"cldf2-6140","tx":"ánqati náyka mákmak","sg":["ánqati","náyka","mákmak"],"gl":["formerly","1SG","eat"],"tl":"I ate; I used to eat; I was eating","anchor":"cldf2-6140"},{"id":"cldf2-6216","tx":"man haitl'kup lup","sg":["man","hai-tl'kup","lup"],"gl":["man","CONT-cut","rope"],"tl":"A man keeps cutting the rope. OR: The man is cutting the rope.","anchor":"cldf2-6216"},{"id":"cldf2-6482","tx":"haws yaxwim","sg":["haws","ya-xwim"],"gl":["house","3SG-fall"],"tl":"The house is falling down. OR: The house keeps falling down.","anchor":"cldf2-6482"},{"id":"cldf2-6635","tx":"álta náyka mámak","sg":["álta","náyka","mámak"],"gl":["now","1SG","eat"],"tl":"I’m eating. I eat NOT: I was eating.","anchor":"cldf2-6635"},{"id":"cldf2-6636","tx":"álta náyka mákmak","sg":["álta","náyka","mákmak"],"gl":["now","1SG","eat"],"tl":"I am eating. OR: Now I'm eating.' (The use of any kind of marker to indicate temporal features in Chinuk Wawa is very much the exception rather than the rule.)","anchor":"cldf2-6636"},{"id":"cldf2-6637","tx":"ánqati náyka mákmak","sg":["ánqati","náyka","mákmak"],"gl":["formerly","1SG","eat"],"tl":"I used to eat. OR: I ate.' (The use of any kind of marker to indicate temporal or aspectual features in Chinuk Wawa is very much the exception rather than the rule.)","anchor":"cldf2-6637"},{"id":"cldf2-6797","tx":"wik ánqati náyka kámtaks","sg":["wik","ánqati","náyka","kámtaks"],"gl":["NEG","formerly","1SG","know"],"tl":"I didn’t know. OR: I hadn’t known.","anchor":"cldf2-6797"},{"id":"cldf2-6949","tx":"pápa yáka tlátwa","sg":["pápa","yáka","tlátwa"],"gl":["father","3SG","go"],"tl":"Father goes.","anchor":"cldf2-6949"},{"id":"cldf2-7058","tx":"lipúm yaka píl","sg":["lipúm","yaka","píl"],"gl":["apple","3SG","red"],"tl":"The apple is red.","anchor":"cldf2-7058"